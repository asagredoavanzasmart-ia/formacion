# Dependencias y compilados (dist se publica aparte, en la rama gh-pages)
node_modules/
build/
dist/
coverage/
*.tsbuildinfo

# Sistema y editores
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# Registros
*.log
npm-debug.log*

# Secretos: nunca se suben. Solo la plantilla .env.example (sin valores reales)
