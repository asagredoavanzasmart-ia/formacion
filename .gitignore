# Material de trabajo de audio (grabaciones, transcripciones, zips): pesa cientos de MB
salida/
*.wav
*.zip

# Herramientas locales: modelos de Whisper (más de 100 MB) y skills personales
.tools/
skills/

# Scripts sueltos de transcripción y alineación de cada entrega de audio
/alinear_*.mjs
/transcribir_*.mjs
/validar_*.mjs
/convertir_*.mjs

# Notas de trabajo de grabación
guiones/*_FALTA_*.txt
guiones/*_REGRABAR_*.txt
